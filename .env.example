# Implantação PostgreSQL; npm run db:local cria uma configuração local SQLite.
DATABASE_URL="postgresql://acolhe:CHANGE_ME@localhost:5432/acolhe?schema=public"
# Gerar com node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
APP_URL="http://localhost:3000"
AI_MODE="demo"
ALLOW_DEMO_CASES="false"
EVALUATION_V2_ENABLED="true"
# Vazio habilita em todas as turmas; para piloto informe IDs separados por vírgulas.
EVALUATION_V2_CLASS_IDS=""
# Somente para seed de desenvolvimento, nunca usar contas demo em implantação real.
DEMO_PASSWORD=""
# Credenciais do provedor ficam SOMENTE em .env.worker; veja .env.worker.example.
# Limites iniciais por dia UTC, aplicados no servidor e compartilhados entre workers.
AI_QUOTA_STUDENT_CHAT="100"
AI_QUOTA_STUDENT_EVALUATION="20"
AI_QUOTA_INSTRUCTOR_CHAT="3000"
AI_QUOTA_INSTRUCTOR_EVALUATION="300"
AI_QUOTA_GLOBAL_CHAT="6000"
AI_QUOTA_GLOBAL_EVALUATION="600"
AI_QUOTA_GLOBAL_PROVIDER="10000"
AI_QUOTA_MINUTE_CHAT="10"
AI_QUOTA_MINUTE_EVALUATION="3"
