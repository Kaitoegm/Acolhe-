# Implantação PostgreSQL; npm run db:local cria uma configuração local SQLite.
DATABASE_URL="postgresql://acolhe:CHANGE_ME@localhost:5432/acolhe?schema=public"
# Gerar com node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
APP_URL="http://localhost:3000"
AI_MODE="demo"
ALLOW_DEMO_CASES="false"
# Somente para seed de desenvolvimento, nunca usar contas demo em implantação real.
DEMO_PASSWORD=""
# Adaptador compatível com Chat Completions, usado somente em AI_MODE=live.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
